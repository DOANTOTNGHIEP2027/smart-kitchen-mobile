#!/bin/sh
# Gate: chặn push nếu workspace này chưa được cấu hình đúng account (phucmouse135),
# nếu credential helper đang trả về account khác, hoặc nếu có commit sắp push bị
# dính author/committer của account khác (ví dụ leak từ global git config).
# Setup: bash scripts/setup-git-identity.sh

EXPECTED_EMAIL="102985779+phucmouse135@users.noreply.github.com"
EXPECTED_LOGIN="phucmouse135"
WRONG_EMAIL="trunghieu.73bc.nguyen@misumi.co.jp"
ZERO="0000000000000000000000000000000000000000"

current_email=$(git config user.email)
if [ "$current_email" != "$EXPECTED_EMAIL" ]; then
  echo "" >&2
  echo "✗ Sai tài khoản git cho workspace này (user.email = ${current_email:-<chưa set>})." >&2
  echo "  Cần dùng: $EXPECTED_EMAIL (phucmouse135 / Nguyễn Đình Phúc)" >&2
  echo "  Fix: bash scripts/setup-git-identity.sh" >&2
  echo "" >&2
  exit 1
fi

cred_username=$(printf 'protocol=https\nhost=github.com\n\n' | git credential fill 2>/dev/null | sed -n 's/^username=//p')
if [ -n "$cred_username" ] && [ "$cred_username" != "$EXPECTED_LOGIN" ]; then
  echo "" >&2
  echo "✗ Credential helper của workspace này đang trả về account '$cred_username', cần '$EXPECTED_LOGIN'." >&2
  echo "  Fix: bash scripts/setup-git-identity.sh" >&2
  echo "" >&2
  exit 1
fi

bad=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  offenders=$(git log "$range" --format='%H %an <%ae> / %cn <%ce>' 2>/dev/null | grep -F "$WRONG_EMAIL")
  if [ -n "$offenders" ]; then
    echo "" >&2
    echo "✗ Phát hiện commit dính account sai ($WRONG_EMAIL) trong $range:" >&2
    echo "$offenders" | sed 's/^/    /' >&2
    bad=1
  fi
done

if [ "$bad" -eq 1 ]; then
  echo "" >&2
  echo "  Sửa commit gần nhất: GIT_COMMITTER_NAME=\"Nguyễn Đình Phúc\" GIT_COMMITTER_EMAIL=$EXPECTED_EMAIL \\" >&2
  echo "    git commit --amend --author=\"Nguyễn Đình Phúc <$EXPECTED_EMAIL>\" --no-edit" >&2
  echo "  Nhiều commit: git rebase -i <base>, sửa từng commit tương tự." >&2
  echo "" >&2
  exit 1
fi

exit 0
